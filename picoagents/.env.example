# Example environment file for picoagents
# Copy this to .env and fill in your actual API keys

# OpenAI API Key (required for most examples)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (get an API key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Azure OpenAI (optional, for Azure examples)
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
