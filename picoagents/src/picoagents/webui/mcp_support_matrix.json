  "features": [
    { "key": "stateless-core", "label": "Stateless core", "description": "No initialize handshake; server/discover + per-request _meta" },
    { "key": "mrtr", "label": "MRTR", "description": "Multi Round-Trip Requests (mid-call input without an open connection)" },
    { "key": "tasks", "label": "Tasks runtime", "description": "Durable task handles: tasks/get polling, tasks/update" },
    { "key": "tasks-types", "label": "Tasks wire types", "description": "Task request/result types available" },
    { "key": "extensions", "label": "Extensions", "description": "Opt-in extension negotiation framework" },
    { "key": "apps", "label": "MCP Apps", "description": "Interactive UI extension" },
    { "key": "auth", "label": "Auth", "description": "OAuth 2.0 resource-server model" },
    { "key": "subscriptions", "label": "Subscriptions", "description": "subscriptions/listen change notifications" }
  ],
